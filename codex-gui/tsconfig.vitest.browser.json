{
  "extends": "./tsconfig.app.json",

  // Override to include only test files and clear exclusions.
  // Application code imported in tests is automatically included via module resolution.
  "include": ["src/**/*.browser.test.ts", "src/**/*.browser.test.tsx"],
  "exclude": [],

  "compilerOptions": {
    "types": ["node", "vite/client", "vitest/browser"],

    // `tsc --build` produces a .tsbuildinfo file for incremental type-checking.
    // Specified here to keep it out of the root directory.
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.vitest.browser.tsbuildinfo"
  }
}
