{
  "name": "codex-gui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "ci": "pnpm run protocol:check-validators && pnpm run format:oxfmt && pnpm run lint && pnpm run type-check && pnpm run test:unit && pnpm run test:browser:smoke",
    "format:oxfmt": "oxfmt --check .",
    "format:oxfmt:fix": "oxfmt . --write",
    "format:prettier": "prettier --check .",
    "format:prettier:fix": "prettier --write .",
    "lint": "pnpm run lint:oxlint && pnpm run lint:eslint",
    "lint:fix": "pnpm run lint:oxlint:fix && pnpm run lint:eslint:fix",
    "lint:oxlint": "oxlint .",
    "lint:oxlint:fix": "oxlint . --fix",
    "lint:eslint": "eslint . --cache",
    "lint:eslint:fix": "eslint . --fix --cache",
    "type-check": "tsc -b --noEmit",
    "test:unit": "vitest --run",
    "test:browser": "pnpm run test:browser:parallel && pnpm run test:browser:sequential",
    "test:browser:parallel": "vitest --config=vitest.browser.parallel.config.ts",
    "test:browser:sequential": "vitest --config=vitest.browser.sequential.config.ts",
    "test:browser:smoke": "vitest --config=vitest.browser.smoke.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "protocol:check-validators": "tsx scripts/protocolValidators/cli.ts --check",
    "protocol:generate-validators": "tsx scripts/protocolValidators/cli.ts --write",
    "messages:extract": "lingui extract",
    "messages:extract:clean": "lingui extract --clean",
    "analyze:large-files": "tsx scripts/large-files/cli.ts",
    "clean:test-artifacts": "tsx scripts/clean-test-artifacts/cli.ts"
  },
  "dependencies": {
    "@heroui/react": "^3.2.4",
    "@heroui/styles": "^3.2.4",
    "@lexical/clipboard": "0.49.0",
    "@lexical/react": "0.49.0",
    "@lingui/core": "^6.6.0",
    "@lingui/react": "^6.6.0",
    "@reduxjs/toolkit": "^2.12.0",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.32",
    "@xyflow/react": "^12.11.5",
    "ajv": "^8.17.1",
    "lexical": "0.49.0",
    "lucide-react": "^1.37.0",
    "mdast-util-to-hast": "13.2.1",
    "pathe": "2.0.3",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-redux": "^9.3.0",
    "streamdown": "^2.6.0",
    "tailwindcss": "^4.3.3",
    "uri-js": "4.4.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/compat": "~2.1.0",
    "@eslint/js": "^10.0.1",
    "@lingui/babel-plugin-lingui-macro": "^6.6.0",
    "@lingui/cli": "^6.6.0",
    "@lingui/vite-plugin": "^6.6.0",
    "@playwright/test": "^1.62.1",
    "@polka/compression": "1.0.0-next.25",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/eslint-plugin": "^1.6.27",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-lingui": "^0.14.0",
    "eslint-plugin-oxlint": "~1.73.0",
    "eslint-plugin-playwright": "^2.11.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-dom": "^5.18.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "eslint-plugin-react-x": "^5.18.6",
    "globals": "^17.11.0",
    "oxfmt": "^0.59.0",
    "oxlint": "~1.74.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vitest-browser-react": "^2.2.0"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
