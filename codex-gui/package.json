{
  "name": "codex-gui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "ci": "pnpm run format && pnpm run lint && pnpm run type-check && pnpm run test",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "pnpm eslint .",
    "lint:fix": "pnpm eslint . --fix",
    "type-check": "tsc -b --noEmit",
    "test": "vitest --run",
    "test:browser": "vitest --config=vitest.browser.config.ts",
    "test:e2e": "playwright test",
    "messages:extract": "lingui extract",
    "messages:extract:clean": "lingui extract --clean"
  },
  "dependencies": {
    "@heroui/react": "^3.0.3",
    "@heroui/styles": "^3.0.3",
    "@lingui/core": "^6.0.0",
    "@lingui/react": "^6.0.0",
    "@reduxjs/toolkit": "^2.11.2",
    "@tailwindcss/vite": "^4.2.4",
    "@tanstack/react-router": "^1.168.25",
    "lucide-react": "^1.14.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-redux": "^9.2.0",
    "tailwindcss": "^4.2.4"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@eslint/compat": "^2.0.5",
    "@eslint/js": "^10.0.1",
    "@lingui/babel-plugin-lingui-macro": "^6.0.0",
    "@lingui/cli": "^6.0.0",
    "@lingui/vite-plugin": "^6.0.0",
    "@playwright/test": "^1.59.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/browser-playwright": "^4.1.5",
    "@vitest/eslint-plugin": "^1.6.16",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-lingui": "^0.13.1",
    "eslint-plugin-playwright": "^2.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-dom": "^4.2.3",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-react-x": "^4.2.3",
    "globals": "^17.5.0",
    "prettier": "^3.8.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.59.1",
    "vite": "^8.0.10",
    "vitest": "^4.1.5",
    "vitest-browser-react": "^2.2.0"
  }
}
