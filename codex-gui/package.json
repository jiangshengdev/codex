{
  "name": "codex-gui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "ci": "pnpm run protocol:check-validators && pnpm run format:oxfmt && pnpm run lint && pnpm run type-check && pnpm run test:unit && pnpm run test:browser:smoke",
    "format:oxfmt": "oxfmt --check .",
    "format:oxfmt:fix": "oxfmt . --write",
    "format:prettier": "prettier --check .",
    "format:prettier:fix": "prettier --write .",
    "lint": "pnpm run lint:oxlint && pnpm run lint:eslint && pnpm run lint:button-sizing",
    "lint:button-sizing": "tsx scripts/buttonSizing/cli.ts",
    "lint:fix": "pnpm run lint:oxlint:fix && pnpm run lint:eslint:fix",
    "lint:oxlint": "oxlint .",
    "lint:oxlint:fix": "oxlint . --fix",
    "lint:eslint": "eslint . --cache",
    "lint:eslint:fix": "eslint . --fix --cache",
    "type-check": "tsc -b --noEmit",
    "test:unit": "vitest --run --project=codex-gui",
    "test:browser": "pnpm run test:browser:parallel && pnpm run test:browser:sequential",
    "test:browser:parallel": "tsx scripts/testRun/cli.ts browser-parallel",
    "test:browser:sequential": "tsx scripts/testRun/cli.ts browser-sequential",
    "test:browser:smoke": "tsx scripts/testRun/cli.ts browser-smoke",
    "test:e2e": "tsx scripts/testRun/cli.ts e2e",
    "test:e2e:headed": "tsx scripts/testRun/cli.ts e2e --headed",
    "test:storybook": "tsx scripts/testRun/cli.ts storybook",
    "test:storybook:stories": "tsx scripts/testRun/cli.ts stories",
    "protocol:check-validators": "tsx scripts/protocolValidators/cli.ts --check",
    "protocol:generate-validators": "tsx scripts/protocolValidators/cli.ts --write",
    "messages:extract": "tsx scripts/storybookIsolation/messages.ts",
    "messages:extract:clean": "tsx scripts/storybookIsolation/messages.ts --clean",
    "verify:storybook-isolation": "tsx scripts/storybookIsolation/artifacts.ts",
    "analyze:large-files": "tsx scripts/large-files/cli.ts",
    "clean:test-artifacts": "tsx scripts/clean-test-artifacts/cli.ts",
    "storybook": "storybook dev -p 6006 --exact-port",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@heroui/react": "^3.2.6",
    "@heroui/styles": "^3.2.6",
    "@lexical/clipboard": "0.50.0",
    "@lexical/react": "0.50.0",
    "@lingui/core": "^6.7.0",
    "@lingui/react": "^6.7.0",
    "@reduxjs/toolkit": "^2.12.0",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.32",
    "@xyflow/react": "^12.11.6",
    "ajv": "^8.17.1",
    "katex": "0.16.47",
    "lexical": "0.50.0",
    "lucide-react": "^1.47.0",
    "mdast-util-to-hast": "13.2.1",
    "pathe": "2.0.3",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-redux": "^9.3.0",
    "streamdown": "^2.6.0",
    "tailwindcss": "^4.3.3",
    "uri-js": "4.4.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@chromatic-com/storybook": "latest",
    "@eslint/compat": "~2.1.1",
    "@eslint/js": "^10.0.1",
    "@lingui/babel-plugin-lingui-macro": "^6.7.0",
    "@lingui/cli": "^6.7.0",
    "@lingui/vite-plugin": "^6.7.0",
    "@playwright/test": "^1.63.0",
    "@polka/compression": "1.0.0-next.25",
    "@rolldown/plugin-babel": "^0.2.4",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-mcp": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/icons": "2.1.0",
    "@storybook/tanstack-react": "^10.6.0",
    "@tanstack/react-query": "latest",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.13.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/eslint-plugin": "^1.6.27",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-lingui": "^0.14.0",
    "eslint-plugin-oxlint": "~1.73.0",
    "eslint-plugin-playwright": "^2.12.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-dom": "^5.19.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-react-x": "^5.19.1",
    "eslint-plugin-storybook": "^10.6.0",
    "globals": "^17.12.0",
    "mdast-util-from-markdown": "2.0.3",
    "micromark-util-types": "2.0.2",
    "oxfmt": "^0.59.0",
    "oxlint": "~1.74.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.8",
    "storybook": "^10.6.0",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "unified": "11.0.5",
    "vite": "^8.3.0",
    "vitest": "^4.1.11",
    "vitest-browser-react": "^2.3.0"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
