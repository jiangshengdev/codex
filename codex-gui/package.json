{
  "name": "codex-gui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "ci": "pnpm run format:oxfmt && pnpm run lint && pnpm run type-check && pnpm run test:unit",
    "format:prettier": "prettier --check .",
    "format:prettier:fix": "prettier --write .",
    "format:oxfmt": "oxfmt --check .",
    "format:oxfmt:fix": "oxfmt . --write",
    "lint": "pnpm run lint:oxlint && pnpm run lint:eslint",
    "lint:fix": "pnpm run lint:oxlint:fix && pnpm run lint:eslint:fix",
    "lint:oxlint": "oxlint .",
    "lint:oxlint:fix": "oxlint . --fix",
    "lint:eslint": "eslint . --cache",
    "lint:eslint:fix": "eslint . --fix --cache",
    "type-check": "tsc -b --noEmit",
    "test:unit": "vitest --run",
    "test:browser": "vitest --config=vitest.browser.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "messages:extract": "lingui extract",
    "messages:extract:clean": "lingui extract --clean",
    "analyze:large-files": "tsx scripts/large-files/cli.ts",
    "clean:test-artifacts": "tsx scripts/clean-test-artifacts/cli.ts"
  },
  "dependencies": {
    "@heroui/react": "^3.2.1",
    "@heroui/styles": "^3.2.1",
    "@lingui/core": "^6.4.0",
    "@lingui/react": "^6.4.0",
    "@reduxjs/toolkit": "^2.12.0",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@tailwindcss/vite": "^4.3.1",
    "@tanstack/react-router": "^1.170.16",
    "lucide-react": "^1.21.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-redux": "^9.3.0",
    "streamdown": "^2.5.0",
    "tailwindcss": "^4.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/compat": "~2.0.5",
    "@eslint/js": "^10.0.1",
    "@lingui/babel-plugin-lingui-macro": "^6.4.0",
    "@lingui/cli": "^6.4.0",
    "@lingui/vite-plugin": "^6.4.0",
    "@playwright/test": "^1.61.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/browser-playwright": "^4.1.9",
    "@vitest/eslint-plugin": "^1.6.20",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-lingui": "^0.13.1",
    "eslint-plugin-oxlint": "~1.69.0",
    "eslint-plugin-playwright": "^2.10.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-dom": "^4.2.3",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-react-x": "^4.2.3",
    "globals": "^17.7.0",
    "oxfmt": "^0.54.0",
    "oxlint": "~1.69.0",
    "prettier": "^3.9.1",
    "tsx": "^4.22.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.0",
    "vitest": "^4.1.9",
    "vitest-browser-react": "^2.2.0"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
